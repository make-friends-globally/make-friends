---
// Card wall (UX §2). Build-time: fetch each member's profile from their own
// repo, render a card. One failing repo never blocks the build (NFR-07).
import Layout from "../layouts/Layout.astro";
import { activeMembers, fetchProfile, purposeColor, LOOKING_FOR_COLORS } from "../lib/data.js";

const members = activeMembers();
const cards = [];
for (const member of members) {
  const profile = await fetchProfile(member.repo, member.profilePath);
  if (!profile) {
    console.warn(`[render] skip ${member.username}: profile fetch/parse failed`);
    continue;
  }
  cards.push({ member, profile });
}
const purposes = Object.keys(LOOKING_FOR_COLORS);
const issuesUrl = "https://github.com/make-friends-globally/make-friends/issues/new";
---

<Layout>
  <section class="hero">
    <h1>A commit is an introduction / commit 即自我介绍</h1>
    <p>
      Developers introduce themselves by committing a profile to their own repository,
      then meet on this wall. A merge is a friendship.
      开发者通过向自己的仓库提交 profile 来介绍自己，然后在这面墙上相遇。一次 merge 就是一段友谊。
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href="https://github.com/make-friends-globally/make-friends/blob/main/requests/new-member.md">
        Introduce yourself / 自我介绍
      </a>
      <a class="btn btn-ghost" href="https://github.com/make-friends-globally/make-friends">
        View the repo / 查看仓库
      </a>
    </div>
  </section>

  <div class="container">
    <div class="filters" id="filters">
      {purposes.map((p) => (
        <button class="chip" data-purpose={p}>{p}</button>
      ))}
      <input class="filter-input" id="f-speaks" placeholder="language / 语言" />
      <input class="filter-input" id="f-city" placeholder="city / 城市" />
      <span class="member-count" id="count">{cards.length} members / 成员</span>
    </div>

    <div class="grid" id="grid">
      {cards.map(({ member, profile }) => (
        <article
          class="card"
          data-purpose={(profile.lookingFor || []).map((v) => v.toLowerCase()).join(" ")}
          data-speaks={(profile.speaks || []).map((v) => v.toLowerCase()).join(" ")}
          data-city={(profile.city || "").toLowerCase()}
        >
          <div class="card-top">
            <img class="avatar" src={`https://github.com/${member.username}.png`} alt="" loading="lazy" width="44" height="44" />
            <div>
              <a class="card-name" href={`/make-friends/members/${member.username}/`}>{profile.name}</a>
              <div class="card-handle">@{member.username}</div>
            </div>
            <div class="time-badge" data-timezone={profile.timezone}>
              <strong>--:--</strong>
              local / 当地时间
            </div>
          </div>
          {profile.bio && <p class="bio">{profile.bio}</p>}
          <div class="chips">
            {(profile.lookingFor || []).map((v) => (
              <span class="purpose-chip" style={`background:${purposeColor(v)}`}>{v}</span>
            ))}
            {(profile.interests || []).slice(0, 3).map((i) => (
              <span class="interest-chip">{i}</span>
            ))}
          </div>
          <div class="card-actions">
            <a class="btn btn-primary" href={`${issuesUrl}?template=ping.yml&title=${encodeURIComponent(`[ping] ${member.username}`)}`}>
              Say hi / 打招呼
            </a>
            <a class="btn btn-ghost" href={`/make-friends/members/${member.username}/#compare`}>
              diff / 缘分
            </a>
          </div>
        </article>
      ))}
    </div>

    {cards.length === 0 && (
      <div class="empty">
        <p>No members yet — be the first to introduce yourself.</p>
        <p>还没有成员——来做第一个自我介绍的人吧。</p>
      </div>
    )}
  </div>
</Layout>

<script>
  // --- URL-driven filtering (UX §2: state lives in the query string) ----
  const params = new URLSearchParams(location.search);
  const chips = [...document.querySelectorAll("[data-purpose]")];
  const speaks = document.getElementById("f-speaks");
  const city = document.getElementById("f-city");
  const grid = document.getElementById("grid");
  const count = document.getElementById("count");
  const cards = [...document.querySelectorAll(".card")];

  function apply() {
    const p = params.get("purpose");
    const s = (params.get("speaks") || "").toLowerCase();
    const c = (params.get("city") || "").toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const ok =
        (!p || card.dataset.purpose.includes(p)) &&
        (!s || (card.dataset.speaks || "").includes(s)) &&
        (!c || (card.dataset.city || "").includes(c));
      card.style.display = ok ? "" : "none";
      if (ok) visible += 1;
    }
    count.textContent = `${visible} members / 成员`;
    chips.forEach((chip) => chip.classList.toggle("active", chip.dataset.purpose === p));
    speaks.value = params.get("speaks") || "";
    city.value = params.get("city") || "";
    history.replaceState(null, "", location.pathname + (params.toString() ? `?${params}` : ""));
  }

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      if (params.get("purpose") === chip.dataset.purpose) params.delete("purpose");
      else params.set("purpose", chip.dataset.purpose);
      apply();
    })
  );
  for (const el of [speaks, city]) {
    el.addEventListener("input", () => {
      const key = el === speaks ? "speaks" : "city";
      if (el.value) params.set(key, el.value);
      else params.delete(key);
      apply();
    });
  }
  apply();

  // --- local-time badges (client-side: always current for any timezone) ----
  for (const badge of document.querySelectorAll("[data-timezone]")) {
    try {
      const tz = badge.dataset.timezone;
      const parts = new Intl.DateTimeFormat("en", { timeZone: tz, hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(new Date());
      const hour = parts.find((p) => p.type === "hour").value;
      const minute = parts.find((p) => p.type === "minute").value;
      const offset = new Intl.DateTimeFormat("en", { timeZone: tz, timeZoneName: "shortOffset" }).formatToParts(new Date());
      badge.querySelector("strong").textContent = `${hour}:${minute}`;
      badge.title = `${tz} (${offset.find((p) => p.type === "timeZoneName").value})`;
    } catch {
      /* unknown timezone: leave placeholder */
    }
  }
</script>
